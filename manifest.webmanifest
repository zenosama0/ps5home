{
  "name": "Playground Home",
  "short_name": "Playground Home",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
  "background_color": "#070a10",
  "theme_color": "#0a0d14",
  "description": "PS5-inspired home screen PWA with local web apps, artwork and per-app music.",
  "icons": [
    { "src": "./assets/icons/icon-192.png", "type": "image/png", "sizes": "192x192", "purpose": "any maskable" },
    { "src": "./assets/icons/icon-512.png", "type": "image/png", "sizes": "512x512", "purpose": "any maskable" }
  ]
}
